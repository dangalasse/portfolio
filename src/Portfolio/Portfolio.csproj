<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Portfolio</RootNamespace>
  </PropertyGroup>

  <Target Name="NpmBuild" BeforeTargets="BeforeBuild" Condition="Exists('package.json')">
    <Exec Command="npm ci --ignore-scripts" Condition="Exists('package-lock.json') And !Exists('node_modules')" />
    <Exec Command="npm install --ignore-scripts" Condition="!Exists('package-lock.json') And !Exists('node_modules')" />
    <Exec Command="npm run build" />
  </Target>

</Project>

@page "/Labs/Static"
@model Portfolio.Pages.Labs.StaticModel
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    ViewData["Title"] = UiCopy.StaticTitle.Resolve(locale);
    ViewData["Description"] = UiCopy.MetaStatic.Resolve(locale);
    var en = AppLocales.IsEnglish(locale);
}

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-signal">
        <a href="/Labs" class="hover:text-paper">Labs</a> / static
    </p>
    <h1 class="reveal mt-4 section-title">@UiCopy.StaticTitle.Resolve(locale)</h1>
    <p class="reveal section-lead">@UiCopy.StaticLead.Resolve(locale)</p>

    <div class="reveal honest-box mt-8">
        <p class="font-mono text-[11px] uppercase tracking-wider text-signal">@UiCopy.HonestLimit.Resolve(locale)</p>
        <p class="mt-2 text-sm leading-relaxed text-paper">
            @(en
                ? "The live URL is two paragraphs of HTML. The proof is private S3 + CloudFront OAC + ACM, described in Terraform. There is no application behind it."
                : "A URL ao vivo é dois parágrafos de HTML. A prova é S3 privado + CloudFront OAC + ACM, descritos em Terraform. Não há aplicação por trás.")
        </p>
    </div>

    <div class="reveal mt-10 space-y-4 text-mist leading-relaxed">
        <h2 class="font-display text-2xl font-semibold text-paper">@(en ? "What to verify" : "O que verificar")</h2>
        <ol class="list-decimal space-y-2 pl-5 text-sm">
            @if (en)
            {
                <li>Open the raw page. If it loads on HTTPS, DNS + ACM closed.</li>
                <li>In the repo: <code>block_public_acls</code>, Origin Access Control, <code>PriceClass_100</code>.</li>
                <li>Do not treat this as a product. It is a Free Tier IaC slice.</li>
            }
            else
            {
                <li>Abra a página crua. Se carrega em HTTPS, DNS + ACM fecharam.</li>
                <li>No repo: <code>block_public_acls</code>, Origin Access Control, <code>PriceClass_100</code>.</li>
                <li>Não trate isto como produto. É uma fatia de IaC Free Tier.</li>
            }
        </ol>
    </div>

    <div class="reveal mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="@SiteFacts.AwsStaticUrl" target="_blank" rel="noopener noreferrer">@UiCopy.OpenRaw.Resolve(locale)</a>
        <a class="btn-ghost" href="https://github.com/dangalasse/aws-static-demo" target="_blank" rel="noopener noreferrer">@UiCopy.ViewSource.Resolve(locale)</a>
    </div>
</section>

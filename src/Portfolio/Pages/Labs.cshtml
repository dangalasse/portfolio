@page
@model Portfolio.Pages.LabsModel
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var labs = PortfolioCatalog.For(locale).Labs;
    ViewData["Title"] = UiCopy.LabsTitle.Resolve(locale);
    ViewData["Description"] = UiCopy.MetaLabs.Resolve(locale);
    var edgeUrl = SiteFacts.ResolveEdgeStatusUrl(Model.Configuration);
    var edgeLive = !string.IsNullOrWhiteSpace(edgeUrl);
    var howTitle = edgeLive
        ? UiCopy.LabsProbeLive.Resolve(locale)
        : UiCopy.LabsProbeFallback.Resolve(locale);
    var steps = edgeLive
        ? (AppLocales.IsEnglish(locale)
            ? new[]
            {
                $"Probe origin: {edgeUrl}",
                "The pill states Cloudflare when this Worker answers, ASP.NET when it does not.",
                "Labs cards are evidence. The product is TOTE; the CI/CD proof is Pipeview.",
            }
            : new[]
            {
                $"Origem do probe: {edgeUrl}",
                "O pill diz Cloudflare quando este Worker responde, ASP.NET quando não.",
                "Os cards de Labs são evidência. O produto é o TOTE; a prova de CI/CD é o Pipeview.",
            })
        : (AppLocales.IsEnglish(locale)
            ? new[]
            {
                "This container has no EDGE_STATUS_URL. The ASP.NET /api/status probe is the live origin.",
                "The Worker source is workers/edge-status. Until it is wired, the pill will not say Cloudflare.",
                "That is a host config gap, not a fake green status.",
            }
            : new[]
            {
                "Este container não tem EDGE_STATUS_URL. O probe ASP.NET /api/status é a origem ao vivo.",
                "O código do Worker está em workers/edge-status. Enquanto não estiver ligado, o pill não diz Cloudflare.",
                "Isso é lacuna de config do host, não um status verde inventado.",
            });
}

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">@UiCopy.LabsTitle.Resolve(locale)</h1>
        <p class="section-lead">@UiCopy.LabsLead.Resolve(locale)</p>
    </div>

    <div class="reveal mt-8 status-pill w-fit" data-lab-status style="transition-delay: 80ms">
        <span class="status-dot" data-status-dot></span>
        <span data-status-label>@UiCopy.Checking.Resolve(locale)</span>
        <span class="text-line">|</span>
        <span data-status-meta>…</span>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
        @foreach (var lab in labs)
        {
            var linkLabel = lab.Id == "observability"
                ? UiCopy.ViewSource.Resolve(locale)
                : UiCopy.TryLive.Resolve(locale);
            var external = lab.DocsUrl?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true;
            <article class="lab-card reveal">
                <p class="font-mono text-[11px] uppercase tracking-wider text-mist">@lab.Provider</p>
                <h2 class="mt-2 font-display text-xl font-semibold text-paper">@lab.Title</h2>
                <p class="mt-3 text-sm leading-relaxed text-mist">@lab.Description</p>
                <p class="mt-4 font-mono text-xs text-signal">@lab.Proof</p>
                @if (!string.IsNullOrWhiteSpace(lab.DocsUrl))
                {
                    <a class="mt-5 inline-block text-sm text-paper underline-offset-4 hover:text-signal hover:underline"
                       href="@lab.DocsUrl"
                       target="@(external ? "_blank" : null)"
                       rel="@(external ? "noopener noreferrer" : null)">@linkLabel</a>
                }
            </article>
        }
    </div>

    <p class="reveal mt-8 text-sm leading-relaxed text-mist">
        @UiCopy.LabsObservabilityNote.Resolve(locale)
    </p>

    <div class="reveal mt-14 border border-line bg-panel/50 p-6 md:p-8">
        <h2 class="font-display text-2xl font-semibold">@howTitle</h2>
        <p class="mt-2 text-sm text-mist">@UiCopy.LabsHowTo.Resolve(locale)</p>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-mist leading-relaxed">
            @foreach (var step in steps)
            {
                <li>@step</li>
            }
        </ol>
    </div>
</section>

@page
@model Portfolio.Pages.LabsModel
@using Portfolio.Data
@{
    ViewData["Title"] = "Labs";
    var labs = PortfolioCatalog.Labs;
}

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">Labs</h1>
        <p class="section-lead">
            Indicadores reais de preview — Cloudflare edge, superfície AWS e ligações GitHub.
            O probe TypeScript actualiza o estado abaixo.
        </p>
    </div>

    <div class="reveal mt-8 status-pill w-fit" data-lab-status style="transition-delay: 80ms">
        <span class="status-dot" data-status-dot></span>
        <span data-status-label>Checking</span>
        <span class="text-line">|</span>
        <span data-status-meta>a consultar /api/status…</span>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
        @foreach (var lab in labs)
        {
            <article class="lab-card reveal" data-lab-status>
                <p class="font-mono text-[11px] uppercase tracking-wider text-mist">@lab.Provider</p>
                <h2 class="mt-2 font-display text-xl font-semibold text-paper">@lab.Title</h2>
                <p class="mt-3 text-sm leading-relaxed text-mist">@lab.Description</p>
                <p class="mt-4 font-mono text-xs text-signal">@lab.Proof</p>
                <div class="mt-6 flex items-center gap-2 text-xs font-mono text-mist">
                    <span class="status-dot" data-status-dot></span>
                    <span data-status-label>…</span>
                    <span data-status-meta></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(lab.DocsUrl))
                {
                    <a class="mt-5 inline-block text-sm text-paper underline-offset-4 hover:text-signal hover:underline" href="@lab.DocsUrl" target="_blank" rel="noopener noreferrer">Docs / link</a>
                }
            </article>
        }
    </div>

    <div class="reveal mt-14 border border-line bg-panel/50 p-6 md:p-8">
        <h2 class="font-display text-2xl font-semibold">Como activar o Worker Cloudflare</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-mist leading-relaxed">
            <li>Criar um Worker que devolva JSON com <code class="text-paper">region</code> e <code class="text-paper">ray</code>.</li>
            <li>Definir a URL no layout via <code class="text-paper">ViewData["EdgeStatusUrl"]</code> ou variável de ambiente.</li>
            <li>O frontend troca automaticamente de “ASP.NET probe” para “Cloudflare”.</li>
        </ol>
    </div>
</section>

@page
@model ErrorModel
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    ViewData["Title"] = UiCopy.ErrorTitle.Resolve(locale);
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["Description"] = UiCopy.ErrorLead.Resolve(locale);
}

<article class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-signal">@UiCopy.ErrorTitle.Resolve(locale)</p>
    <h1 class="reveal mt-4 font-display text-4xl font-bold tracking-tight md:text-5xl" style="transition-delay: 60ms">
        @UiCopy.ErrorTitle.Resolve(locale)
    </h1>
    <p class="reveal mt-5 max-w-xl text-lg text-mist leading-relaxed" style="transition-delay: 100ms">
        @UiCopy.ErrorLead.Resolve(locale)
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="reveal mt-8 font-mono text-xs text-mist" style="transition-delay: 140ms">
            @UiCopy.ErrorRequestId.Resolve(locale)
            <span class="text-line"> · </span>
            <code class="text-paper">@Model.RequestId</code>
        </p>
    }
    <div class="reveal mt-10 flex flex-wrap gap-3" style="transition-delay: 180ms">
        <a class="btn-primary" href="/">@UiCopy.NavHome.Resolve(locale)</a>
        <a class="btn-ghost" href="/Projects">@UiCopy.BackToProjects.Resolve(locale)</a>
    </div>
</article>

@page
@model Portfolio.Pages.AboutModel
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var profile = PortfolioCatalog.For(locale).Profile;
    ViewData["Title"] = UiCopy.AboutTitle.Resolve(locale);
    var aboutBody = AppLocales.IsEnglish(locale)
        ? "I work on infrastructure, SRE, DevOps, and cloud products: ASP.NET Core, TypeScript, Cloudflare, and AWS. This site is the evidence hub — live Free Tier demos (S3/CloudFront, Workers AI, Actions→Workers) plus public repos with Terraform, Ansible, Helm, and OTEL."
        : "Trabalho com infraestrutura, SRE, DevOps e cloud: ASP.NET Core, TypeScript, Cloudflare e AWS. Este site é o hub de evidências — demos Free Tier ao vivo (S3/CloudFront, Workers AI, Actions→Workers) e repos públicos com Terraform, Ansible, Helm e OTEL.";
    var reviewerNote = AppLocales.IsEnglish(locale)
        ? "Reviewer map (15 min):"
        : "Mapa para recrutadores (15 min):";
}

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">@UiCopy.AboutTitle.Resolve(locale)</h1>
        <p class="section-lead">@profile.Tagline</p>
    </div>
    <div class="reveal mt-10 space-y-4 text-mist leading-relaxed" style="transition-delay: 80ms">
        <p>@aboutBody</p>
        <p>
            @reviewerNote
            <a class="text-signal hover:underline" href="https://github.com/dangalasse/portfolio/blob/main/docs/RECRUITER.md" target="_blank" rel="noopener noreferrer">docs/RECRUITER.md</a>
            ·
            <a class="text-signal hover:underline" href="https://static.galasse.dev" target="_blank" rel="noopener noreferrer">static.galasse.dev</a>
            ·
            <a class="text-signal hover:underline" href="https://edge.galasse.dev/health" target="_blank" rel="noopener noreferrer">edge.galasse.dev</a>
            ·
            <a class="text-signal hover:underline" href="https://pipeline.galasse.dev" target="_blank" rel="noopener noreferrer">pipeline.galasse.dev</a>
        </p>
        <p>
            @UiCopy.Location.Resolve(locale): @profile.Location.
            @UiCopy.Contact.Resolve(locale): <a class="text-signal hover:underline" href="mailto:@profile.Email">@profile.Email</a>.
        </p>
    </div>
    <div class="reveal mt-10 flex flex-wrap gap-3" style="transition-delay: 140ms">
        <a class="btn-primary" href="@profile.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn-ghost" href="@profile.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
        @if (!string.IsNullOrWhiteSpace(profile.CvPdfPath))
        {
            <a class="btn-ghost" href="@profile.CvPdfPath">CV PDF</a>
        }
    </div>
</section>

@page
@model Portfolio.Pages.AboutModel
@using Portfolio.Data
@using Portfolio.I18n
@using Portfolio.Models
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var profile = PortfolioCatalog.For(locale).Profile;
    ViewData["Title"] = UiCopy.AboutTitle.Resolve(locale);
    ViewData["Description"] = UiCopy.MetaAbout.Resolve(locale);
    var aboutBody = AppLocales.IsEnglish(locale)
        ? "I work on infrastructure, SRE, DevOps, and cloud — mostly ASP.NET Core, TypeScript, Cloudflare, and AWS. This site is where I keep the live pieces: Free Tier demos (S3/CloudFront, Workers AI, Actions→Workers) and public repos with Terraform, Ansible, Helm, and OpenTelemetry."
        : "Trabalho com infraestrutura, SRE, DevOps e cloud — principalmente ASP.NET Core, TypeScript, Cloudflare e AWS. Este site é onde deixo as peças ao vivo: demos Free Tier (S3/CloudFront, Workers AI, Actions→Workers) e repos públicos com Terraform, Ansible, Helm e OpenTelemetry.";
}

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">@UiCopy.AboutTitle.Resolve(locale)</h1>
        <p class="section-lead">@profile.Tagline</p>
    </div>
    <div class="reveal mt-10 space-y-4 text-mist leading-relaxed" style="transition-delay: 80ms">
        <p>@aboutBody</p>
        <p>
            @UiCopy.RecruiterStrip.Resolve(locale)
            <a class="text-signal hover:underline" href="https://github.com/dangalasse/portfolio/blob/main/docs/RECRUITER.md" target="_blank" rel="noopener noreferrer">docs/RECRUITER.md</a>
            ·
            <a class="text-signal hover:underline" href="https://static.galasse.dev" target="_blank" rel="noopener noreferrer">static.galasse.dev</a>
            ·
            <a class="text-signal hover:underline" href="https://edge.galasse.dev/health" target="_blank" rel="noopener noreferrer">edge.galasse.dev</a>
            ·
            <a class="text-signal hover:underline" href="https://pipeview.galasse.dev" target="_blank" rel="noopener noreferrer">pipeview.galasse.dev</a>
        </p>
        <p>
            @UiCopy.Location.Resolve(locale): @profile.Location.
            @UiCopy.Contact.Resolve(locale): <a class="text-signal hover:underline" href="mailto:@profile.Email">@profile.Email</a>.
        </p>
    </div>
    <div class="reveal mt-10" style="transition-delay: 140ms">
        <partial name="_SocialLinks" model="new SocialLinksModel { Profile = profile, Locale = locale, Variant = SocialLinksVariant.About }" />
    </div>
</section>

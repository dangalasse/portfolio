@page
@model Portfolio.Pages.AboutModel
@using Portfolio.Data
@using Portfolio.I18n
@using Portfolio.Models
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var profile = SiteFacts.WithPublishedCv(ViewContext.HttpContext, PortfolioCatalog.For(locale).Profile);
    ViewData["Title"] = UiCopy.AboutTitle.Resolve(locale);
    ViewData["Description"] = UiCopy.MetaAbout.Resolve(locale);
    var en = AppLocales.IsEnglish(locale);
}

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">@UiCopy.AboutTitle.Resolve(locale)</h1>
        <p class="section-lead">@profile.Tagline</p>
    </div>
    <div class="reveal mt-10 space-y-4 text-mist leading-relaxed" style="transition-delay: 80ms">
        @if (en)
        {
            <p>
                I work on infrastructure, SRE, DevOps, and cloud. The product in this portfolio is
                <a class="text-signal hover:underline" href="/Projects/tote">TOTE</a>
                (TypeScript). This site is ASP.NET because the host already runs .NET — that is operations, not a claim that TOTE is a .NET app.
            </p>
            <p>
                I am not presenting myself as an AI developer here. There is a Workers AI playground under
                <a class="text-signal hover:underline" href="https://edge.galasse.dev/" target="_blank" rel="noopener noreferrer">edge.galasse.dev</a>.
                That proves an inference call. It does not prove training, evals, or model operations.
            </p>
            <p>
                I do not invent workplace impact on this page. LinkedIn and GitHub are the employment and code records.
                This site is the live evidence hub — and it now says what is product, what is proof, and what is a lab.
            </p>
        }
        else
        {
            <p>
                Trabalho com infraestrutura, SRE, DevOps e cloud. O produto neste portfólio é o
                <a class="text-signal hover:underline" href="/Projects/tote">TOTE</a>
                (TypeScript). Este site é ASP.NET porque o host já opera .NET — isso é operação, não a afirmação de que o TOTE é um app .NET.
            </p>
            <p>
                Não me apresento aqui como IA developer. Existe um playground de Workers AI em
                <a class="text-signal hover:underline" href="https://edge.galasse.dev/" target="_blank" rel="noopener noreferrer">edge.galasse.dev</a>.
                Isso prova uma chamada de inferência. Não prova treino, eval nem operação de modelo.
            </p>
            <p>
                Não invento impacto de emprego nesta página. LinkedIn e GitHub são o registro profissional e o código.
                Este site é o hub de evidência ao vivo — e agora diz o que é produto, o que é prova e o que é lab.
            </p>
        }
        <p>
            @UiCopy.Location.Resolve(locale): @profile.Location.
            @UiCopy.Contact.Resolve(locale): <a class="text-signal hover:underline" href="mailto:@profile.Email">@profile.Email</a>.
        </p>
    </div>
    <div class="reveal mt-10" style="transition-delay: 140ms">
        <partial name="_SocialLinks" model="new SocialLinksModel { Profile = profile, Locale = locale, Variant = SocialLinksVariant.About }" />
    </div>
    <div class="mt-16 border-t border-line pt-12">
        <partial name="_RecruiterMap" />
    </div>
</section>

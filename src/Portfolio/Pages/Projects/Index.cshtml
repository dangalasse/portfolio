@page
@model Portfolio.Pages.Projects.IndexModel
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var catalog = PortfolioCatalog.For(locale);
    ViewData["Title"] = UiCopy.ProjectsTitle.Resolve(locale);
}

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">@UiCopy.ProjectsTitle.Resolve(locale)</h1>
        <p class="section-lead">@UiCopy.ProjectsLead.Resolve(locale)</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
        @foreach (var project in catalog.Projects)
        {
            <a href="/Projects/@project.Slug" class="project-tile group reveal p-6">
                <div class="mb-6 h-1 w-12" style="background: @project.Accent"></div>
                <h2 class="font-display text-2xl font-semibold text-paper group-hover:text-signal transition-colors">@project.Title</h2>
                <p class="mt-3 text-sm leading-relaxed text-mist">@project.Summary</p>
                <p class="mt-6 font-mono text-xs uppercase tracking-wider text-mist/80">@string.Join(" · ", project.Stack)</p>
            </a>
        }
    </div>
</section>

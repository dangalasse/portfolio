@page
@model Portfolio.Pages.Projects.IndexModel
@using Portfolio.Data
@{
    ViewData["Title"] = "Projectos";
    var projects = PortfolioCatalog.Projects;
}

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="reveal">
        <h1 class="section-title">Projectos</h1>
        <p class="section-lead">Cada item tem stack, nota de demo e caminho para prova ao vivo quando existir.</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
        @foreach (var project in projects)
        {
            <a href="/Projects/@project.Slug" class="project-tile group reveal p-6 md:p-8">
                <div class="mb-6 flex items-center justify-between gap-3">
                    <div class="h-1 w-16" style="background: @project.Accent"></div>
                    @if (project.Featured)
                    {
                        <span class="font-mono text-[10px] uppercase tracking-wider text-signal">Featured</span>
                    }
                </div>
                <h2 class="font-display text-2xl font-semibold text-paper transition-colors group-hover:text-signal">@project.Title</h2>
                <p class="mt-3 text-mist leading-relaxed">@project.Summary</p>
                <ul class="mt-6 flex flex-wrap gap-2">
                    @foreach (var tech in project.Stack)
                    {
                        <li class="border border-line px-2 py-1 font-mono text-[11px] text-mist">@tech</li>
                    }
                </ul>
            </a>
        }
    </div>
</section>

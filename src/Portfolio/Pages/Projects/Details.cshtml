@page "/Projects/{slug}"
@model Portfolio.Pages.Projects.DetailsModel
@using Portfolio.Data
@using Portfolio.I18n
@using Portfolio.Models
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    ViewData["Title"] = Model.Project.Title;
    var project = Model.Project;
    var flow = Model.Architecture;
    string T(L text) => text.Resolve(locale);
    ViewData["Robots"] = "noindex, follow";
    ViewData["Description"] = project.Summary;
    var liveExternal = project.LiveUrl?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true;
    var cta = string.IsNullOrWhiteSpace(project.LiveCta) ? T(UiCopy.LiveDemo) : project.LiveCta;
    var isLab = project.Kind == ProjectKind.Lab;
}

<article class="mx-auto max-w-5xl px-4 py-16 md:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-signal">
        <a href="/Projects" class="hover:text-paper">@T(UiCopy.NavProjects)</a>
        / @T(UiCopy.ForKind(project.Kind))
        / @project.Slug
    </p>
    <h1 class="reveal mt-4 font-display text-4xl font-bold tracking-tight md:text-5xl" style="transition-delay: 60ms">@project.Title</h1>
    <p class="reveal mt-5 max-w-3xl text-lg text-mist leading-relaxed" style="transition-delay: 100ms">@project.Summary</p>

    <div class="reveal mt-8 flex flex-wrap gap-3" style="transition-delay: 140ms">
        @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
        {
            <a class="btn-primary" href="@project.LiveUrl" target="@(liveExternal ? "_blank" : null)" rel="noopener noreferrer">@cta</a>
        }
        @if (!string.IsNullOrWhiteSpace(project.RepoUrl))
        {
            <a class="btn-ghost" href="@project.RepoUrl" target="_blank" rel="noopener noreferrer">@T(UiCopy.ViewSource)</a>
        }
        @if (isLab)
        {
            <a class="btn-ghost" href="/Labs">@T(UiCopy.NavLabs)</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(project.Problem))
    {
        <div class="reveal mt-12 border-t border-line pt-10" style="transition-delay: 180ms">
            <h2 class="font-display text-2xl font-semibold">@T(UiCopy.Problem)</h2>
            <p class="mt-3 max-w-3xl text-mist leading-relaxed">@project.Problem</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(project.HonestLimit))
    {
        <div class="reveal mt-8 honest-box">
            <p class="font-mono text-[11px] uppercase tracking-wider text-signal">@T(UiCopy.HonestLimit)</p>
            <p class="mt-2 text-sm leading-relaxed text-paper">@project.HonestLimit</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(project.VerifyHint))
    {
        <div class="reveal mt-8">
            <h2 class="font-display text-2xl font-semibold">@T(UiCopy.Verify)</h2>
            <p class="mt-3 max-w-3xl text-mist leading-relaxed">@project.VerifyHint</p>
        </div>
    }

    <div class="reveal mt-10 space-y-6">
        <h2 class="font-display text-2xl font-semibold">@T(UiCopy.Context)</h2>
        <p class="max-w-3xl text-mist leading-relaxed">@project.Description</p>
        @if (!string.IsNullOrWhiteSpace(project.DemoNote))
        {
            <p class="border border-line bg-panel/60 px-4 py-3 font-mono text-sm text-paper">@project.DemoNote</p>
        }
    </div>

    <div class="reveal mt-10">
        <h2 class="font-display text-2xl font-semibold">@T(UiCopy.Stack)</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
            @foreach (var tech in project.Stack)
            {
                <li class="border border-line bg-ink-soft px-3 py-1.5 font-mono text-xs text-mist">@tech</li>
            }
        </ul>
    </div>

    @if (flow is not null)
    {
        <div class="mt-12 border-t border-line pt-10">
            <partial name="_ArchitectureFlow" model="flow" />
        </div>
    }
</article>

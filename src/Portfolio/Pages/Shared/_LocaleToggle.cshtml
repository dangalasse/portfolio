@model string
@using Portfolio.Data
@using Portfolio.I18n
@{
    var locale = AppLocales.Normalize(Model);
    var isEn = AppLocales.IsEnglish(locale);
    var switchTo = isEn ? AppLocales.PtBr : AppLocales.EnUs;
    var label = isEn ? "EN" : "PT";
    var title = isEn ? UiCopy.LocaleEnLabel.EnUs : UiCopy.LocalePtLabel.PtBr;
}
<form method="post" action="/api/locale" class="inline-flex">
    <input type="hidden" name="locale" value="@switchTo" />
    <input type="hidden" name="returnUrl" value="@(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString)" />
    <button
        type="submit"
        class="locale-toggle inline-flex items-center gap-1.5 border border-line bg-panel/70 px-2 py-1 text-xs text-mist transition hover:border-signal/50 hover:text-paper"
        title="@title — @UiCopy.SwitchLanguage.Resolve(locale)"
        aria-label="@UiCopy.SwitchLanguage.Resolve(locale): @title">
        @if (isEn)
        {
            <span class="locale-flag" aria-hidden="true">
                <svg width="18" height="12" viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#b22234"/><rect y="1" width="18" height="1" fill="#fff"/><rect y="3" width="18" height="1" fill="#fff"/><rect y="5" width="18" height="1" fill="#fff"/><rect y="7" width="18" height="1" fill="#fff"/><rect y="9" width="18" height="1" fill="#fff"/><rect y="11" width="18" height="1" fill="#fff"/><rect width="7.2" height="6.5" fill="#3c3b6e"/></svg>
            </span>
            <span class="font-mono tracking-wide">ENG-US</span>
        }
        else
        {
            <span class="locale-flag" aria-hidden="true">
                <svg width="18" height="12" viewBox="0 0 18 12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#009c3b"/><polygon points="9,1.2 16.5,6 9,10.8 1.5,6" fill="#ffdf00"/><circle cx="9" cy="6" r="2.4" fill="#002776"/></svg>
            </span>
            <span class="font-mono tracking-wide">PT-BR</span>
        }
    </button>
</form>

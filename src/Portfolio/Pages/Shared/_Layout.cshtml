@using System.Text.Json
@using Portfolio.Data
@using Portfolio.I18n
@using Portfolio.Models
@{
    var locale = Locale.Current(ViewContext.HttpContext);
    var catalog = PortfolioCatalog.For(locale);
    var profile = SiteFacts.WithPublishedCv(ViewContext.HttpContext, catalog.Profile);
    var path = ViewContext.HttpContext.Request.Path.Value ?? "/";
    string T(L text) => text.Resolve(locale);
    var edgeStatusUrl = ViewData["EdgeStatusUrl"] as string
        ?? ViewContext.HttpContext.Items["EdgeStatusUrl"] as string
        ?? "";

    var request = ViewContext.HttpContext.Request;
    var baseUrl = string.IsNullOrWhiteSpace(profile.SiteUrl)
        ? $"{request.Scheme}://{request.Host.Value}"
        : profile.SiteUrl.TrimEnd('/');
    var canonicalPath = path == "/" ? "" : path.TrimEnd('/');
    var canonical = $"{baseUrl}{canonicalPath}";
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? profile.Name : $"{pageTitle} · {profile.Name}";
    var description = ViewData["Description"] as string;
    if (string.IsNullOrWhiteSpace(description))
    {
        description = profile.Tagline;
    }
    var robots = ViewData["Robots"] as string ?? "index, follow";
    var ogImage = $"{baseUrl}/icon-192.png";

    var websiteJson = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = profile.Name,
        ["url"] = baseUrl + "/",
        ["description"] = description,
        ["inLanguage"] = new[] { "pt-BR", "en-US" },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = profile.Name,
            ["url"] = baseUrl + "/",
            ["email"] = profile.Email,
            ["jobTitle"] = profile.Role,
            ["sameAs"] = new[] { profile.GitHubUrl, profile.LinkedInUrl },
        },
    });

    var personJson = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = profile.Name,
        ["url"] = baseUrl + "/",
        ["email"] = profile.Email,
        ["jobTitle"] = profile.Role,
        ["description"] = profile.Tagline,
        ["image"] = $"{baseUrl}/images/danton-galasse.jpg",
        ["sameAs"] = new[] { profile.GitHubUrl, profile.LinkedInUrl },
        ["knowsAbout"] = new[] { "SRE", "DevOps", "Infrastructure", "Cloudflare", "AWS" },
    });
}
<!DOCTYPE html>
<html lang="@locale">
<head>
    @* If you're reading View Source: welcome. Secrets aren't here — try the live Labs demos instead. *@
    <!-- Fourth wall: scanners hitting /.env get a wink, not credentials. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonical" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@profile.Name" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="@(AppLocales.IsEnglish(locale) ? "en_US" : "pt_BR")" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@500;600;700&display=swap" rel="stylesheet" />

    @* Google Search favicon: square PNG, size multiple of 48px. *@
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon-48.png" type="image/png" sizes="48x48" asp-append-version="true" />
    <link rel="icon" href="~/favicon-96.png" type="image/png" sizes="96x96" asp-append-version="true" />
    <link rel="icon" href="~/icon-192.png" type="image/png" sizes="192x192" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" sizes="180x180" asp-append-version="true" />
    <meta name="theme-color" content="#0b1215" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script type="application/ld+json">@Html.Raw(websiteJson)</script>
    <script type="application/ld+json">@Html.Raw(personJson)</script>
</head>
<body class="site-shell grain" data-edge-status-url="@edgeStatusUrl" data-locale="@locale">
    @* Recruiter: product is TOTE, proof is Pipeview, labs are evidence. CV only if the PDF exists. *@
    <header class="border-b border-line/80 backdrop-blur-sm sticky top-0 z-40 bg-ink/80">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6">
            <a href="/" class="font-display text-lg font-bold tracking-tight text-paper hover:text-signal transition-colors">
                @profile.Name
            </a>
            <nav class="hidden md:flex items-center gap-6" aria-label="@T(UiCopy.NavMainAria)">
                <a class="nav-link" href="/" aria-current="@(path == "/" ? "page" : null)">@T(UiCopy.NavHome)</a>
                <a class="nav-link" href="/Projects" aria-current="@(path.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase) ? "page" : null)">@T(UiCopy.NavProjects)</a>
                <a class="nav-link" href="/Labs" aria-current="@(path.StartsWith("/Labs", StringComparison.OrdinalIgnoreCase) ? "page" : null)">@T(UiCopy.NavLabs)</a>
                <a class="nav-link" href="/About" aria-current="@(path.StartsWith("/About", StringComparison.OrdinalIgnoreCase) ? "page" : null)">@T(UiCopy.NavAbout)</a>
            </nav>
            <div class="hidden md:flex items-center gap-3">
                <partial name="_LocaleToggle" model="locale" />
                <partial name="_SocialLinks" model="new SocialLinksModel { Profile = profile, Locale = locale, Variant = SocialLinksVariant.Nav }" />
            </div>
            <button type="button" class="md:hidden btn-ghost !px-3 !py-1.5" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">@T(UiCopy.NavMenu)</button>
        </div>
        <div id="mobile-nav" class="hidden border-t border-line md:hidden" data-nav-panel data-open="false">
            <nav class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4" aria-label="Mobile">
                <a class="nav-link" href="/">@T(UiCopy.NavHome)</a>
                <a class="nav-link" href="/Projects">@T(UiCopy.NavProjects)</a>
                <a class="nav-link" href="/Labs">@T(UiCopy.NavLabs)</a>
                <a class="nav-link" href="/About">@T(UiCopy.NavAbout)</a>
                <div class="flex flex-wrap items-center gap-3 pt-2">
                    <partial name="_LocaleToggle" model="locale" />
                    <partial name="_SocialLinks" model="new SocialLinksModel { Profile = profile, Locale = locale, Variant = SocialLinksVariant.Nav }" />
                </div>
            </nav>
        </div>
    </header>

    <main class="flex-1">
        @RenderBody()
    </main>

    <footer class="border-t border-line mt-16">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 md:flex-row md:items-center md:justify-between md:px-6">
            <p class="text-sm text-mist">
                <span class="font-display text-paper">@profile.Name</span>
                · <span data-year></span>
                · ASP.NET Core · TypeScript · Tailwind
            </p>
            <partial name="_SocialLinks" model="new SocialLinksModel { Profile = profile, Locale = locale, Variant = SocialLinksVariant.Footer }" />
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

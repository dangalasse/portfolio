@using Portfolio.Models
@using Portfolio.Data
@using Portfolio.I18n
@model ArchitectureFlow
@{
    var flow = Model;
    var locale = Locale.Current(ViewContext.HttpContext);
    string T(L text) => text.Resolve(locale);

    var maxCol = flow.Nodes.Count == 0 ? 0 : flow.Nodes.Max(n => n.Column);
    var columns = Enumerable.Range(0, maxCol + 1)
        .Select(col => flow.Nodes.Where(n => n.Column == col).OrderBy(n => n.Row).ToList())
        .Where(list => list.Count > 0)
        .ToList();

    var edgesJson = System.Text.Json.JsonSerializer.Serialize(
        flow.Edges.Select(e => new { from = e.From, to = e.To, label = e.Label }));

    var nodesJson = System.Text.Json.JsonSerializer.Serialize(
        flow.Nodes.Select(n => new
        {
            id = n.Id,
            label = n.Label,
            subtitle = n.Subtitle,
            plain = n.PlainExplain,
            recruiter = n.RecruiterDetail,
            snippet = n.CodeSnippet,
            repoUrl = n.RepoUrl,
            color = n.Color,
        }));
}

<section
    class="arch-flow reveal"
    data-arch-flow
    data-arch-locale="@locale"
    aria-label="@flow.Title">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h2 class="font-display text-2xl font-semibold text-paper">@flow.Title</h2>
            <p class="mt-2 max-w-2xl text-sm text-mist leading-relaxed">@flow.Caption</p>
            <p class="mt-2 max-w-2xl text-xs text-mist/80">@T(UiCopy.FlowHint)</p>
        </div>
        <p class="font-mono text-[10px] uppercase tracking-wider text-mist/70">@T(UiCopy.FlowByPlatform)</p>
    </div>

    <div class="arch-canvas mt-8" data-arch-canvas>
        <svg class="arch-wires" data-arch-wires aria-hidden="true"></svg>

        <div class="arch-grid" data-arch-grid style="--arch-cols: @columns.Count">
            @for (var c = 0; c < columns.Count; c++)
            {
                <div class="arch-column" data-arch-column="@c">
                    @foreach (var node in columns[c])
                    {
                        var hex = node.Color.TrimStart('#');
                        <button
                            type="button"
                            class="arch-node"
                            data-arch-node="@node.Id"
                            data-arch-color="@node.Color"
                            style="--node-accent: @node.Color"
                            aria-haspopup="dialog"
                            aria-controls="arch-drawer">
                            <span class="arch-node-handle arch-node-handle--in" aria-hidden="true"></span>
                            <span class="arch-node-icon" aria-hidden="true">
                                <img
                                    class="arch-icon-img"
                                    src="https://cdn.simpleicons.org/@node.Icon/@hex"
                                    alt=""
                                    width="22"
                                    height="22"
                                    loading="lazy"
                                    decoding="async" />
                                <span class="arch-node-fallback font-mono text-xs" style="color: @node.Color; display: none;">@(node.Label[0])</span>
                            </span>
                            <span class="min-w-0 text-left">
                                <span class="arch-node-title">@node.Label</span>
                                <span class="arch-node-sub">@node.Subtitle</span>
                            </span>
                            <span class="arch-node-handle arch-node-handle--out" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <aside
        id="arch-drawer"
        class="arch-drawer"
        data-arch-drawer
        hidden
        role="dialog"
        aria-modal="false"
        aria-labelledby="arch-drawer-title">
        <div class="arch-drawer-head">
            <div>
                <p class="arch-drawer-kicker" data-arch-drawer-sub></p>
                <h3 id="arch-drawer-title" class="arch-drawer-title" data-arch-drawer-title></h3>
            </div>
            <button type="button" class="arch-drawer-close" data-arch-drawer-close aria-label="@T(UiCopy.FlowClose)">×</button>
        </div>
        <div class="arch-drawer-body">
            <section>
                <h4>@T(UiCopy.FlowExplain)</h4>
                <p data-arch-drawer-plain></p>
            </section>
            <section>
                <h4>@T(UiCopy.FlowRecruiter)</h4>
                <p data-arch-drawer-recruiter></p>
            </section>
            <section>
                <div class="arch-drawer-snippet-head">
                    <h4>@T(UiCopy.FlowSnippet)</h4>
                    <button type="button" class="arch-copy-btn" data-arch-drawer-copy>@T(UiCopy.FlowCopy)</button>
                </div>
                <pre class="arch-snippet"><code data-arch-drawer-snippet></code></pre>
            </section>
            <p class="arch-drawer-repo" hidden>
                <a data-arch-drawer-repo href="#" target="_blank" rel="noopener noreferrer">@T(UiCopy.FlowOpenRepo)</a>
            </p>
        </div>
    </aside>

    <script type="application/json" data-arch-edges>@Html.Raw(edgesJson)</script>
    <script type="application/json" data-arch-nodes>@Html.Raw(nodesJson)</script>
    <script type="application/json" data-arch-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        copy = T(UiCopy.FlowCopy),
        copied = T(UiCopy.FlowCopied),
        close = T(UiCopy.FlowClose),
    }))</script>
</section>
